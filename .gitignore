# dependencies
node_modules/

# Expo / Metro
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Generated native projects (Continuous Native Generation: `expo prebuild`)
apps/*/android/
apps/*/ios/

# Native signing material: never commit
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# env files
.env
.env*.local
!.env.example

# misc
*.tsbuildinfo
.DS_Store
npm-debug.*
yarn-debug.*
yarn-error.*
.turbo/

# Local agent worktrees / tooling
.claude/

# Firebase / Google credentials: never commit (the admin SDK key is a secret; google-services.json goes in as an EAS file env var)
*firebase-adminsdk*.json
*service-account*.json
google-services.json
GoogleService-Info.plist
