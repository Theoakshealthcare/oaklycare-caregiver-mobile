{
  "request": {
    "method": "POST",
    "path": "/api/v1/auth/change-password",
    "auth": "bearer",
    "body": {
      "current_password": "Not-The-Password-9",
      "new_password": "<new-password>"
    }
  },
  "response": {
    "status": 400,
    "body": {
      "detail": {
        "code": "wrong_current_password",
