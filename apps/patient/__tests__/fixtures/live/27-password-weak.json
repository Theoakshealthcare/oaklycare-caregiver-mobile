{
  "request": {
    "method": "POST",
    "path": "/api/v1/auth/change-password",
    "auth": "bearer",
    "body": {
      "current_password": "<password>",
      "new_password": "aaaaaaaa"
    }
  },
  "response": {
    "status": 400,
