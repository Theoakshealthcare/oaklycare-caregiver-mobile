{
  "request": {
    "method": "POST",
    "path": "/api/v1/auth/change-password",
    "auth": "bearer",
    "body": {
      "current_password": "<password>",
      "new_password": "<password>"
    }
  },
  "response": {
    "status": 400,
    "body": {
      "detail": {
        "code": "same_password",
        "message": "Choose a password you are not using now."
      }
    }
  }
}
