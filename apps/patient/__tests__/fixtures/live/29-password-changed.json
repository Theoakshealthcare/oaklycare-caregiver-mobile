{
  "request": {
    "method": "POST",
    "path": "/api/v1/auth/change-password",
    "auth": "bearer",
    "body": {
      "current_password": "<password>",
      "new_password": "<new-password>"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "access_token": "<jwt>",
      "refresh_token": "<jwt>",
      "token_type": "bearer",
      "detail": "Password changed."
    }
  }
}
