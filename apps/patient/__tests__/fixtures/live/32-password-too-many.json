{
  "request": {
    "method": "POST",
    "path": "/api/v1/auth/change-password",
    "auth": "bearer",
    "body": {
      "current_password": "Not-The-Password-9",
      "new_password": "<password>"
    }
  },
  "response": {
    "status": 429,
    "retryAfter": "30",
    "body": {
      "detail": {
        "code": "too_many_attempts",
        "message": "Too many incorrect attempts. Please wait before trying again."
      }
    }
  }
}
