{
  "name": "oakly-apps",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "api:sync": "pnpm --filter @oakly/api-client sync",
    "api:generate": "pnpm --filter @oakly/api-client generate",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "caregiver": "pnpm --filter caregiver start"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
