{
  "name": "@oakly/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the Oakly backend, generated from its OpenAPI spec.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "sync": "node scripts/sync-openapi.mjs && pnpm generate",
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  }
}
